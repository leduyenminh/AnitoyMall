# Copy to .env.local for local development. On AWS these are set by the CDK stack
# (secrets come from AWS Secrets Manager, never from plain environment variables).

# ---------- Public (inlined at build time) ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=VND
NEXT_PUBLIC_SHIPPING_FEE=30000
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=150000
NEXT_PUBLIC_DELIVERY_ETA=2–5
# Where "Buy on TikTok Shop" goes; {id} is the TikTok Shop product id.
NEXT_PUBLIC_TIKTOK_PRODUCT_URL_TEMPLATE=https://shop.tiktok.com/view/product/{id}?region=VN&locale=vi-VN
NEXT_PUBLIC_TIKTOK_SHOP_URL=https://www.tiktok.com/@leduyenminh
# TikTok Pixel (TikTok Ads Manager → Assets → Events). Loads only after visitor consent.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# Bank account that receives VietQR transfers (all three required to offer bank transfer).
# NEXT_PUBLIC_VIETQR_BANK_ID=MB
# NEXT_PUBLIC_VIETQR_ACCOUNT_NO=
# NEXT_PUBLIC_VIETQR_ACCOUNT_NAME=
# NEXT_PUBLIC_CONTACT_PHONE=
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_CONTACT_ZALO=

# ---------- Server ----------
# local = JSON file in .data/ ; dynamodb = AWS DynamoDB (or DynamoDB Local via DYNAMODB_ENDPOINT)
DATA_BACKEND=local
# AWS_REGION=ap-southeast-1
# TABLE_NAME=anitoy-mall
# DYNAMODB_ENDPOINT=http://localhost:8000

# Seller back office at /admin (HTTP Basic auth). Leave empty to disable it.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# TikTok Shop Partner Center app (partner.tiktokshop.com → App & Service)
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=
# TikTok for Business Events API access token (server-side conversions)
TIKTOK_EVENTS_ACCESS_TOKEN=
# TikTok for Developers app (Login Kit + Display API) for video view counts
TIKTOK_DISPLAY_CLIENT_KEY=
TIKTOK_DISPLAY_CLIENT_SECRET=

# ---------- Online payments (each method shows at checkout once its gateway is set) ----------
# Defaults are the providers' sandboxes; use production endpoints and keys when going live.
# ZaloPay (wallet; also cards/ATM when VNPay is not set) – docs.zalopay.vn
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
# ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn
# MoMo wallet – developers.momo.vn
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# MOMO_ENDPOINT=https://test-payment.momo.vn
# VNPay (Visa/Mastercard/JCB and ATM/Internet Banking) – sandbox.vnpayment.vn
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
