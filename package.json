{
  "name": "anitoy-mall",
  "version": "1.0.0",
  "private": true,
  "description": "Mall of Anitoy storefront: Next.js on AWS (Lambda + CloudFront + DynamoDB), synced with TikTok Shop",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "media": "node scripts/import-tiktok-media.mjs",
    "sync": "tsx --env-file-if-exists=.env.local scripts/sync.ts",
    "db:init": "tsx --env-file-if-exists=.env.local scripts/init-dynamodb.ts",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1152.0",
    "@aws-sdk/client-dynamodb": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-secrets-manager": "^3.1152.0",
    "@aws-sdk/client-sesv2": "^3.1152.0",
    "@aws-sdk/client-sqs": "^3.1152.0",
    "@aws-sdk/lib-dynamodb": "^3.1152.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  }
}
